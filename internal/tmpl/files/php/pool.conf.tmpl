;;
;; PHP-FPM pool for {{ .Domain }}
;;
;; Every site gets its own pool running as its own system user. This is the
;; difference between one compromised plugin costing you one site and costing
;; you every site on the box: with a shared www-data pool, any PHP file on the
;; server can read every other site's wp-config.php and therefore every other
;; site's database credentials.
;;
;; Generated by ngxsetup — local edits are overwritten.
;;

[{{ .Slug }}]

user  = {{ .User }}
group = {{ .Group }}

;; nginx runs as www-data and must be able to write to the socket; the site
;; user owns it. 0660 keeps every other account off it.
listen       = {{ .SocketPath }}
listen.owner = www-data
listen.group = www-data
listen.mode  = 0660
listen.backlog = {{ .Plan.PHP.ListenBacklog }}

;; Process manager
pm = {{ .Plan.PHP.PM }}
pm.max_children = {{ .Plan.PHP.MaxChildren }}
{{- if eq .Plan.PHP.PM "dynamic" }}
pm.start_servers = {{ .Plan.PHP.StartServers }}
pm.min_spare_servers = {{ .Plan.PHP.MinSpareServers }}
pm.max_spare_servers = {{ .Plan.PHP.MaxSpareServers }}
{{- end }}
{{- if eq .Plan.PHP.PM "ondemand" }}
pm.process_idle_timeout = {{ .Plan.PHP.ProcessIdleTimeout }}
{{- end }}

;; Recycle workers to bound leaks in third-party plugins without paying fork
;; cost on every request.
pm.max_requests = {{ .Plan.PHP.MaxRequests }}

;; Status and health endpoints, reachable only over the unix socket — never
;; exposed through a site's server block.
pm.status_path = /{{ .Slug }}-fpm-status
ping.path      = /{{ .Slug }}-fpm-ping

;; Timeouts. PHP's own max_execution_time fires first so the error lands in the
;; PHP log with a stack context; this is the hard backstop for requests that
;; block somewhere PHP cannot interrupt, such as a hung database socket.
request_terminate_timeout = {{ .Plan.PHP.RequestTerminateTimeout }}s
request_slowlog_timeout   = {{ .Plan.PHP.SlowlogTimeout }}s
slowlog = /var/log/php/{{ .Slug }}.slow.log

rlimit_files = {{ .Plan.PHP.RlimitFiles }}
rlimit_core  = 0

catch_workers_output = yes
decorate_workers_output = no

;; Per-pool logging so a noisy site is attributable.
php_admin_value[error_log] = /var/log/php/{{ .Slug }}.error.log
php_admin_flag[log_errors] = on
php_admin_flag[display_errors] = off

;; Confine the site to its own tree. A path traversal or file-read bug in a
;; plugin cannot reach another site's files, /etc, or the system's own PHP
;; configuration.
php_admin_value[open_basedir] = {{ .Root }}:{{ .TmpDir }}:{{ .SessionDir }}:/usr/share/php:/dev/urandom
php_admin_value[sys_temp_dir]    = {{ .TmpDir }}
php_admin_value[upload_tmp_dir]  = {{ .TmpDir }}
php_admin_value[session.save_path] = {{ .SessionDir }}

;; Sessions are per-site, so one site cannot read or forge another's.
php_admin_value[session.cookie_httponly] = 1
php_admin_value[session.cookie_samesite] = "Lax"
php_admin_flag[session.use_strict_mode]  = on
{{- if .TLS }}
php_admin_value[session.cookie_secure] = 1
{{- end }}

php_admin_value[memory_limit] = {{ mem .Plan.PHP.MemoryLimitMB }}
php_admin_value[max_execution_time] = {{ .Plan.PHP.MaxExecutionTime }}
{{- if .StrictFunctions }}

;; Process-spawning functions are the payload of nearly every PHP web shell.
;; They are disabled for web requests only — wp-cli runs under the CLI SAPI and
;; keeps them, so backups and migrations still work.
php_admin_value[disable_functions] = exec,passthru,shell_exec,system,proc_open,popen,proc_nice,proc_terminate,proc_get_status,pcntl_exec,pcntl_fork,dl,symlink,link
{{- end }}

;; WordPress reads these; without them the site cannot find its own paths when
;; the environment is cleared.
env[HOSTNAME] = $HOSTNAME
env[PATH]     = /usr/local/bin:/usr/bin:/bin
env[TMP]      = {{ .TmpDir }}
env[TMPDIR]   = {{ .TmpDir }}
env[TEMP]     = {{ .TmpDir }}
