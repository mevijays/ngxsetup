<?php
/**
 * Managed by ngxsetup — created once and never rewritten, because it holds
 * this site's database credentials and salts.
 *
 * Salts are generated locally with the system CSPRNG rather than fetched from
 * the WordPress salt API, so provisioning needs no network round trip and no
 * third party ever sees the keys protecting this site's sessions.
 */

define( 'DB_NAME', '{{ .DBName }}' );
define( 'DB_USER', '{{ .DBUser }}' );
define( 'DB_PASSWORD', '{{ .DBPassword }}' );
define( 'DB_HOST', 'localhost' );
define( 'DB_CHARSET', 'utf8mb4' );
define( 'DB_COLLATE', '' );

$table_prefix = '{{ .TablePrefix }}';

{{ range .Salts }}define( '{{ .Name }}', '{{ .Value }}' );
{{ end }}
/**
 * The site is served over HTTPS but PHP talks to nginx over FastCGI, so
 * is_ssl() must be told the original scheme or WordPress emits http:// asset
 * URLs on an https:// page and browsers block them as mixed content.
 */
if ( isset( $_SERVER['HTTP_X_FORWARDED_PROTO'] ) && 'https' === $_SERVER['HTTP_X_FORWARDED_PROTO'] ) {
	$_SERVER['HTTPS'] = 'on';
}

/**
 * Editing plugin and theme code through the admin interface turns any stolen
 * administrator session into remote code execution. Deployment belongs in
 * version control, not in a browser textarea.
 */
define( 'DISALLOW_FILE_EDIT', true );

/**
 * WordPress writes to its own directories to install updates. That means the
 * web server can rewrite the code it executes, which is how a single upload
 * bug becomes a persistent backdoor. Updates are applied with wp-cli instead:
 *
 *     ngxsetup site update {{ .Domain }}
 */
define( 'DISALLOW_FILE_MODS', {{ if .AllowFileMods }}false{{ else }}true{{ end }} );

{{ if .DisableCron }}
/**
 * wp-cron fires on visitor requests, which makes page load times depend on
 * whatever scheduled work happens to be due. ngxsetup runs it from a systemd
 * timer instead, so it is predictable and does not block a reader.
 */
define( 'DISABLE_WP_CRON', true );
{{ end }}

define( 'WP_MEMORY_LIMIT', '{{ .MemoryLimit }}' );
define( 'WP_MAX_MEMORY_LIMIT', '{{ .AdminMemoryLimit }}' );

/* Post revisions are unbounded by default; a heavily edited page can
   accumulate hundreds of rows that are queried on every edit. */
define( 'WP_POST_REVISIONS', 10 );
define( 'EMPTY_TRASH_DAYS', 14 );
define( 'AUTOSAVE_INTERVAL', 120 );

define( 'WP_DEBUG', false );
define( 'WP_DEBUG_DISPLAY', false );
define( 'WP_DEBUG_LOG', false );

{{ if .SiteURL }}
define( 'WP_HOME', '{{ .SiteURL }}' );
define( 'WP_SITEURL', '{{ .SiteURL }}' );
{{ end }}

if ( ! defined( 'ABSPATH' ) ) {
	define( 'ABSPATH', __DIR__ . '/' );
}

require_once ABSPATH . 'wp-settings.php';
