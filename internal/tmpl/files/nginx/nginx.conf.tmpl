user www-data;
worker_processes {{ .Plan.Nginx.WorkerProcesses }};
worker_rlimit_nofile {{ .Plan.Nginx.WorkerRlimitNofile }};
pid /run/nginx.pid;

include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections {{ .Plan.Nginx.WorkerConnections }};
    multi_accept {{ if .Plan.Nginx.MultiAccept }}on{{ else }}off{{ end }};
    use epoll;
}

http {
    ##
    # Transfer
    ##
    sendfile           on;
    tcp_nopush         on;
    tcp_nodelay        on;
    aio                threads;
    directio           4m;

    ##
    # Timeouts
    #
    # keepalive_requests is deliberately high: renegotiating TLS for every few
    # requests is far more expensive than holding an idle connection.
    ##
    keepalive_timeout        {{ .Plan.Nginx.KeepaliveTimeout }};
    keepalive_requests       {{ .Plan.Nginx.KeepaliveRequests }};
    client_body_timeout      15s;
    client_header_timeout    15s;
    send_timeout             30s;
    reset_timedout_connection on;

    ##
    # Buffers
    ##
    client_max_body_size        {{ mem .Plan.Nginx.ClientMaxBodyMB }};
    client_body_buffer_size     {{ .Plan.Nginx.ClientBodyBufferKB }}k;
    client_header_buffer_size   4k;
    large_client_header_buffers {{ .Plan.Nginx.LargeHeaderBuffers }};
    output_buffers              2 32k;
    postpone_output             1460;

    ##
    # Hash tables
    #
    # The distribution default of 32 is too small for long domain names and
    # produces a startup failure that reads like a syntax error.
    ##
    types_hash_max_size          2048;
    server_names_hash_bucket_size 128;
    variables_hash_max_size      2048;

    ##
    # Identity
    ##
    server_tokens off;
    charset       utf-8;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    ##
    # Open file descriptor cache: avoids a stat() per request for static files.
    ##
    open_file_cache          max={{ .Plan.Nginx.OpenFileCacheMax }} inactive=60s;
    open_file_cache_valid    120s;
    open_file_cache_min_uses 2;
    open_file_cache_errors   on;

    ##
    # Logging
    #
    # Access logging stays ON. The previous configuration disabled it globally
    # while pointing fail2ban at the access log, so no jail could ever match.
    # Buffered writes keep the cost negligible.
    ##
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                    'rt=$request_time uct=$upstream_connect_time urt=$upstream_response_time '
                    'cache=$upstream_cache_status host=$host';

    access_log /var/log/nginx/access.log main buffer=64k flush=5s;
    error_log  /var/log/nginx/error.log warn;

    ##
    # Managed configuration. Files are numbered so ordering is explicit:
    # maps and zones must be defined before the servers that reference them.
    ##
    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}
