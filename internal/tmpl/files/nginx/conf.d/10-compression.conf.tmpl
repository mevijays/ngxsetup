##
# Compression
#
# gzip_static serves a pre-compressed .gz sibling when one exists, which costs
# no CPU at request time. Compression level is chosen against the core count:
# on a single-core box the highest levels cost more than they save.
##

gzip              on;
gzip_vary         on;
gzip_proxied      any;
gzip_comp_level   {{ .Plan.Nginx.GzipCompLevel }};
gzip_min_length   256;
gzip_buffers      16 8k;
gzip_http_version 1.1;
gzip_static       on;
gzip_disable      "msie6";

gzip_types
    application/atom+xml
    application/geo+json
    application/javascript
    application/json
    application/ld+json
    application/manifest+json
    application/rdf+xml
    application/rss+xml
    application/vnd.ms-fontobject
    application/wasm
    application/x-web-app-manifest+json
    application/xhtml+xml
    application/xml
    font/eot
    font/otf
    font/ttf
    image/bmp
    image/svg+xml
    image/x-icon
    text/cache-manifest
    text/calendar
    text/css
    text/javascript
    text/markdown
    text/plain
    text/vcard
    text/vtt
    text/x-component
    text/xml;

# Note: image/jpeg, image/png and image/webp are deliberately absent. They are
# already compressed; running them through gzip burns CPU for no size gain.
