##
# Site: {{ .Domain }}
#
# Generated by ngxsetup. Local edits are overwritten on the next apply — use
# {{ .OverridePath }} for site-specific additions, which is included at the end
# of the server block and is never rewritten.
##
{{ if .TLS }}
server {
    listen 80;
    listen [::]:80;
    server_name {{ .ServerNames }};

    # Renewal has to work over plain HTTP, so the challenge path is served
    # before the redirect rather than after it.
    location ^~ /.well-known/acme-challenge/ {
        root {{ .ACMERoot }};
        default_type "text/plain";
    }

    location / {
        return 301 https://{{ .PrimaryName }}$request_uri;
    }
}
{{ end }}
server {
{{- if .TLS }}
    listen 443 ssl{{ if eq .HTTP2Style "listen" }} http2{{ end }};
    listen [::]:443 ssl{{ if eq .HTTP2Style "listen" }} http2{{ end }};
{{- if eq .HTTP2Style "directive" }}
    http2 on;
{{- end }}

    ssl_certificate     {{ .CertPath }};
    ssl_certificate_key {{ .KeyPath }};
{{- if .ChainPath }}
    ssl_trusted_certificate {{ .ChainPath }};
{{- end }}
{{- if .OCSPStapling }}
    # Only meaningful for a CA-issued certificate — see 20-ssl.conf.tmpl for
    # why this is not a global setting.
    ssl_stapling        on;
    ssl_stapling_verify on;
{{- end }}
{{- else }}
    listen 80;
    listen [::]:80;
{{- end }}

    server_name {{ .ServerNames }};
    root {{ .Root }};
    index index.php index.html;

    access_log /var/log/nginx/{{ .Slug }}.access.log main buffer=64k flush=5s;
    error_log  /var/log/nginx/{{ .Slug }}.error.log warn;

    include snippets/ngxsetup/{{ .HeadersSnippet }};

    # Bounds the damage a single address can do by holding connections open.
    limit_conn ngx_conn {{ .Plan.Nginx.ConnPerIP }};

    # WordPress, including its REST API, only ever needs these methods.
    # TRACE/TRACK enable cross-site tracing attacks against cookies that
    # HttpOnly is supposed to protect; CONNECT has no business reaching an
    # origin server at all. Not configurable — nothing legitimate sends these.
    if ($request_method !~ ^(?:GET|HEAD|POST|PUT|DELETE|PATCH|OPTIONS)$) {
        return 405;
    }
{{ if .BlockBadAgents }}
    # Known scanners, exploitation frameworks, header-injection payloads, and
    # clients that send no User-Agent at all.
    if ($ngx_bad_agent) { return 444; }
{{ end }}
{{ if .BlockBadReferrers }}
    # Long-running referrer-spam campaigns that exist purely to pollute
    # analytics; blocking them costs nothing a real visitor would notice.
    if ($ngx_bad_referer) { return 444; }
{{ end }}
{{ if .BlockScraperBots }}
    # AI-training and SEO/backlink crawlers. Opt-in: unlike the scanners
    # above, nothing here is attacking the site — this is a content-policy
    # choice, not a security one.
    if ($ngx_scraper_bot) { return 444; }
{{ end }}
    location ^~ /.well-known/acme-challenge/ {
        root {{ .ACMERoot }};
        default_type "text/plain";
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
        expires 30d;
    }

    # robots.txt and the sitemap are usually generated by a plugin rather than
    # written to disk, so they fall through to PHP when no file exists.
    location = /robots.txt {
        access_log off;
        log_not_found off;
        try_files $uri /index.php?$args;
    }

    include snippets/ngxsetup/hardening.conf;

    ##
    # Static assets.
    #
    # Served straight from disk with a one-year lifetime. WordPress appends a
    # ?ver= query to its own asset URLs, so a plugin update changes the URL and
    # the long lifetime never serves a stale file. `immutable` additionally
    # stops browsers revalidating on reload.
    #
    # The security header snippet is re-included because the add_header below
    # would otherwise discard every header inherited from the server block.
    ##
    location ~* \.(?:css|js|mjs|jpg|jpeg|png|gif|ico|webp|avif|svg|svgz|woff|woff2|ttf|otf|eot|mp4|webm|ogg|ogv|mp3|wav|pdf|zip|map)$ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        include snippets/ngxsetup/{{ .HeadersSnippet }};
        access_log off;
        log_not_found off;
        try_files $uri =404;
    }
{{ if .AdminAllowList }}
    ##
    # Administrative endpoints restricted by address. Everything not listed is
    # refused before WordPress ever runs, so credential stuffing cannot even
    # reach the login form.
    ##
    location ~* ^/(wp-admin/|wp-login\.php) {
{{- range .AdminAllowList }}
        allow {{ . }};
{{- end }}
        deny all;

        location ~ \.php$ {
{{- range .AdminAllowList }}
            allow {{ . }};
{{- end }}
            deny all;
            limit_req zone=ngx_login burst={{ .Plan.Nginx.ReqBurstLogin }} nodelay;
            include snippets/ngxsetup/fastcgi-php.conf;
            fastcgi_pass unix:{{ .SocketPath }};
        }
        try_files $uri $uri/ /index.php?$args;
    }
{{ else }}
    ##
    # The login form is the most-attacked endpoint on a WordPress site. It gets
    # its own per-minute budget so a brute-force run is throttled without
    # affecting ordinary browsing.
    ##
    location = /wp-login.php {
        limit_req zone=ngx_login burst={{ .Plan.Nginx.ReqBurstLogin }} nodelay;
        include snippets/ngxsetup/fastcgi-php.conf;
        fastcgi_pass unix:{{ .SocketPath }};
    }
{{ end }}
{{ if .BlockXMLRPC }}
    # xmlrpc.php is a pingback and brute-force amplifier. Almost nothing needs
    # it now that the mobile apps use the REST API; it is refused outright.
    location = /xmlrpc.php {
        deny all;
        access_log off;
        return 444;
    }
{{ else }}
    location = /xmlrpc.php {
        limit_req zone=ngx_login burst=2 nodelay;
        include snippets/ngxsetup/fastcgi-php.conf;
        fastcgi_pass unix:{{ .SocketPath }};
    }
{{ end }}
    # wp-cron.php fires on visitor requests by default, which makes page loads
    # slower and unpredictable. ngxsetup installs a systemd timer instead and
    # blocks the HTTP trigger.
    location = /wp-cron.php {
        deny all;
        access_log off;
        return 444;
    }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    ##
    # PHP.
    ##
    location ~ \.php$ {
        limit_req zone=ngx_general burst={{ .Plan.Nginx.ReqBurstGeneral }} nodelay;

        include snippets/ngxsetup/fastcgi-php.conf;
        fastcgi_pass unix:{{ .SocketPath }};
{{ if .CacheEnabled }}
        fastcgi_cache        WORDPRESS;
        fastcgi_cache_valid  200 301 302 {{ .Plan.Nginx.CacheValid }};
        fastcgi_cache_valid  404 1m;
        fastcgi_cache_bypass $skip_cache;
        fastcgi_no_cache     $skip_cache $ngx_response_is_private;

        add_header X-Cache-Status $upstream_cache_status always;
{{- else }}
        add_header X-Cache-Status "DISABLED" always;
{{- end }}
        # Re-included: the add_header above resets header inheritance.
        include snippets/ngxsetup/{{ .HeadersSnippet }};
    }

    # Site-specific overrides. Created empty and never rewritten.
    include {{ .OverridePath }};
}
